# HTTP port for the Bun server
PORT=3000

# SQLite database file (created automatically)
DATABASE_PATH=./data/scraper.db

# Optional: point Playwright at an existing Chromium binary instead of the one
# it downloads itself. Useful in containers that pre-install browsers.
# CHROMIUM_EXECUTABLE_PATH=/opt/pw-browsers/chromium

# Run Chromium with --no-sandbox (required in most Docker/CI containers)
# CHROMIUM_NO_SANDBOX=1
